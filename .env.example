# Copy this file to .env and fill in the key for the provider you want to use:
#   cp .env.example .env

# Which provider the chat API uses: google | openai | openrouter
# Leave empty to auto-detect - the first provider below with a key set wins,
# checked in the order google, openai, openrouter.
AI_PROVIDER=google

# Optional model override. Empty uses the provider default:
#   google     -> gemini-2.5-flash
#   openai     -> gpt-4o-mini
#   openrouter -> openrouter/free
AI_MODEL=

# Only the key for the selected provider is required.
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Shows the "I am OPEN for new opportunity" banner on the homepage.
# Set to false for "Currently NOT open". Anything else reads as true.
# Inlined at build time - a change needs a rebuild or redeploy, not a code push.
NEXT_PUBLIC_OPEN_TO_WORK=true
