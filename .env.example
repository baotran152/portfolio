# Copy this file to .env and fill in the key for the provider you want to use:
#   cp .env.example .env

# Preferred provider for the chat API: google | openai | openrouter
# Every OTHER provider that has a key below becomes a fallback, tried in order
# (google, openai, openrouter) when the preferred one is rate limited or failing.
# Leave empty to auto-detect - the first provider with a key becomes the preferred one.
AI_PROVIDER=google

# Optional model override. Applies to the PREFERRED provider only, since a model id
# is provider-specific; fallbacks always use their own default below. Empty uses:
#   google     -> gemini-2.5-flash
#   openai     -> gpt-4o-mini
#   openrouter -> openrouter/free
AI_MODEL=

# Only the key for the selected provider is required.
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Shows the "I am OPEN for new opportunity" banner on the homepage.
# Set to false for "Currently NOT open". Anything else reads as true.
# Read server side per request, so it never reaches the browser.
OPEN_TO_WORK=true
